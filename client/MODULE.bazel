bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "abseil-cpp", version = "20250127.0")
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "protobuf", version = "30.0")
bazel_dep(name = "grpc", version = "1.72.0-pre1")
bazel_dep(name = "boringssl", version = "0.20241024.0")  # same version grpc pins; used by sam3d_tls_test
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_python", version = "1.3.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.3")

single_version_override(
    module_name = "rules_android_ndk",
    patch_strip = 1,
    patches = [
        "//third_party/rules_android_ndk:windows_fix.patch",
    ],
    version = "0.1.3",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = False,
    ignore_root_user_error = True,
    python_version = "3.10",
)

android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
android_ndk.configure(
    api_level = 21,
)
use_repo(android_ndk, "androidndk")
# The NDK toolchain is registered only by --config=android (.bazelrc), so a desktop build needs no NDK.

# The scan API proto lives at the repository root (../proto), shared with the Python server in ../server.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "scan_proto",
    build_file = "//session/inference/distributed/proto:scan_proto.BUILD.bazel",
    path = "../proto",
)
