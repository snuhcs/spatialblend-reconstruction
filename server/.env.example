# The scan server's own values. Copy to server/.env (git-ignored; scripts/configure_secrets.py creates it with mode 600)
# or export them in the environment, which wins. Never commit server/.env. Check with: python3 scripts/configure_secrets.py --check

# Secret. A Hugging Face read token of an account that has been granted access to facebook/sam3 and
# facebook/sam-3d-objects (https://huggingface.co/settings/tokens). Used only to download the weights.
HF_TOKEN=

# Settings (README.md, "Configuration"). Empty means the default.
SAM3D_OBJECTS_ROOT=
SAM3D_OBJECTS_CHECKPOINTS=
HF_HOME=
SAM3D_SCAN_HOST=
SAM3D_SCAN_PORT=
SAM3D_SCAN_GPUS=
